generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── User ─────────────────────────────────────────────────────────────────────
// Thin record linking a Clerk identity to a Stripe customer.
model User {
  id               String        @id @default(cuid())
  clerkId          String        @unique
  email            String        @unique
  username         String?       @unique
  stripeCustomerId String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  subscription     Subscription?
}

// ── Subscription ──────────────────────────────────────────────────────────────
// Mirrored from Stripe via webhooks. Source of truth for feature gating.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String    @unique
  stripePriceId        String
  status               String    // trialing | active | past_due | canceled | unpaid | incomplete | incomplete_expired
  currentPeriodEnd     DateTime
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
}

// ── GameResult ──────────────────────────────────────────────────────────────
// Stores every GAME_OVER postMessage from iframe games.
// One row per user per game per day (upserts on replay for arcade).
model GameResult {
  id           String   @id @default(cuid())
  game         String
  gameType     String   // "puzzle" | "arcade"
  userId       String
  date         String   // YYYY-MM-DD (UTC)
  puzzleNumber Int
  score        Int
  completed    Boolean
  shareText    String?
  streak       Int      @default(0)
  maxStreak    Int      @default(0)
  smgVersion   String   @default("1.1")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([game, userId, date])
  @@index([game, date])
  @@index([userId])
}

model LeaderboardScore {
  id        String   @id @default(cuid())
  game      String
  userId    String
  userName  String
  score     Int
  lines     Int      @default(0)
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([game, userId])
  @@index([game, score])
}

// ── Kit games (Claude Games kit) ────────────────────────────────────────────
// Best score per player per game for games built with the Claude Games kit
// (served from /proto). Players are Clerk users or guests ("guest:<id>") who
// post under a nickname. See src/app/api/kit/.
model KitScore {
  id        String   @id @default(cuid())
  game      String
  playerId  String   // Clerk user id, or "guest:<browser id>"
  name      String
  score     Int
  plays     Int      @default(1)
  isGuest   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([game, playerId])
  @@index([game, score])
  @@index([playerId])
}

// Achievements on a signed-in player's account. game is a kit game id, or
// "site" for site-wide achievements (see src/lib/siteAchievements.ts).
model Achievement {
  id         String   @id @default(cuid())
  userId     String   // Clerk user id
  game       String
  key        String
  unlockedAt DateTime @default(now())

  @@unique([userId, game, key])
  @@index([userId])
}

// ── Tester feedback (the /lab queue) ─────────────────────────────────────────
// Notes testers record, type or upload about a kit game. Pushing a batch from /lab starts
// the claude-games "feedback" GitHub workflow: recordings are transcribed (Whisper), Claude
// applies the notes on a branch and ships preview builds; Approve takes them live.
// See src/lib/lab.ts.
model Feedback {
  id         String   @id @default(cuid())
  game       String
  text       String   @default("") // typed or uploaded notes, or the browser's live draft of a recording
  audio      Bytes?   // the recording itself (webm/ogg/mp4, a few MB at most)
  audioType  String?
  transcript String?  // Whisper's transcript of the recording
  heard      String?  // Claude's short read of what the tester meant
  link       String?  // where to test the change: the preview build (review) or the live game (live)
  context    String?  // JSON: build, seconds into the session, screen size
  status     String   @default("new") // see STATUSES in src/lib/lab.ts
  note       String?  // what Claude changed, why it skipped, or a reviewer's comment
  commit     String?  // claude-games commit (review: on the batch branch; live: on main, used by Undo)
  run        String?  // batch id (the GitHub Actions run that handled it)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([commit])
  @@index([run])
}

// ── New games from a GDD (the /lab/builds area) ───────────────────────────────
// A tester uploads a design doc; Push to Claude starts the claude-games workflow in "build" mode,
// which builds the game on branch build/<id> and ships a test build to /proto/preview/build-<id>/.
// Testers ask for changes (each push = a new version), then Send to power user; a power user
// publishes it (merged into the kit, shipped to the live site). See src/lib/builds.ts.
model GameBuild {
  id        String   @id @default(cuid())
  title     String
  slug      String   // the game's id in the kit (games/<slug>) and on the site (/play/<slug>)
  fileName  String
  fileType  String
  file      Bytes    // the uploaded GDD, a few MB at most
  notes     String   @default("") // anything the uploader adds for Claude
  request   String?  // the latest change request (for the next version)
  status    String   @default("draft") // see BUILD_STATUSES in src/lib/builds.ts
  note      String?  // Claude's summary of the latest version, or why it failed
  preview   String?  // the latest test build's path on the site
  versions  Int      @default(0)
  run       String?  // GitHub run working on it
  commit    String?  // latest commit (branch while testing, main once live)
  log       String   @default("[]") // JSON history: [{ at, event, text }]
  reuse     String?  // JSON from the latest version: { plan, reused, added, candidates, gameLines, kitLines }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ── Play stats (the lab's Games page) ─────────────────────────────────────────
// One row per play of a game, updated in place while it runs. A play starts at the player's
// first input; seconds is active time only (tab visible, input in the last minute); runs counts
// game overs. Sent by @kit/site Telemetry in claude-games. lab marks plays by passcode holders so testing stays out of the numbers.
model Play {
  id        String   @id // made by the browser: p + random
  game      String
  playerId  String   // Clerk user id, or "guest:<browser id>"
  day       String   // the day it started, YYYY-MM-DD in Atlantic time
  seconds   Int      @default(0)
  runs      Int      @default(0)
  lab       Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([day])
  @@index([game, day])
}
