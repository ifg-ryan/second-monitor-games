generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── User ─────────────────────────────────────────────────────────────────────
// Thin record linking a Clerk identity to a Stripe customer.
model User {
  id               String        @id @default(cuid())
  clerkId          String        @unique
  email            String        @unique
  username         String?       @unique
  stripeCustomerId String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  subscription     Subscription?
}

// ── Subscription ──────────────────────────────────────────────────────────────
// Mirrored from Stripe via webhooks. Source of truth for feature gating.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String    @unique
  stripePriceId        String
  status               String    // trialing | active | past_due | canceled | unpaid | incomplete | incomplete_expired
  currentPeriodEnd     DateTime
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
}

// ── GameResult ──────────────────────────────────────────────────────────────
// Stores every GAME_OVER postMessage from iframe games.
// One row per user per game per day (upserts on replay for arcade).
model GameResult {
  id           String   @id @default(cuid())
  game         String
  gameType     String   // "puzzle" | "arcade"
  userId       String
  date         String   // YYYY-MM-DD (UTC)
  puzzleNumber Int
  score        Int
  completed    Boolean
  shareText    String?
  streak       Int      @default(0)
  maxStreak    Int      @default(0)
  smgVersion   String   @default("1.1")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([game, userId, date])
  @@index([game, date])
  @@index([userId])
}

model LeaderboardScore {
  id        String   @id @default(cuid())
  game      String
  userId    String
  userName  String
  score     Int
  lines     Int      @default(0)
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([game, userId])
  @@index([game, score])
}

// ── Kit games (Claude Games kit) ────────────────────────────────────────────
// Best score per player per game for games built with the Claude Games kit
// (served from /proto). Players are Clerk users or guests ("guest:<id>") who
// post under a nickname. See src/app/api/kit/.
model KitScore {
  id        String   @id @default(cuid())
  game      String
  playerId  String   // Clerk user id, or "guest:<browser id>"
  name      String
  score     Int
  plays     Int      @default(1)
  isGuest   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([game, playerId])
  @@index([game, score])
  @@index([playerId])
}

// Achievements on a signed-in player's account. game is a kit game id, or
// "site" for site-wide achievements (see src/lib/siteAchievements.ts).
model Achievement {
  id         String   @id @default(cuid())
  userId     String   // Clerk user id
  game       String
  key        String
  unlockedAt DateTime @default(now())

  @@unique([userId, game, key])
  @@index([userId])
}

// ── Tester feedback (the /lab queue) ─────────────────────────────────────────
// Notes testers dictate while playing a kit game. Pushing a batch from /lab starts
// the claude-games "feedback" GitHub workflow, which has Claude apply the notes,
// re-ships the games, and writes the result back here. See src/lib/lab.ts.
model Feedback {
  id        String   @id @default(cuid())
  game      String
  text      String
  context   String?  // JSON: build, seconds into the session, screen size
  status    String   @default("new") // new | queued | working | live | skipped | failed | dismissed | undoing | undone
  note      String?  // Claude's one-line summary of what it did, or why it skipped
  commit    String?  // claude-games commit that applied it (used by Undo)
  run       String?  // GitHub Actions run that handled it
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([commit])
}
